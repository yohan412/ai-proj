# LLM (Ollama). 사전 준비: ollama pull gemma4:e4b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=300
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.2
OLLAMA_EXPLAIN_TEMPERATURE=0.3

# 프롬프트에 넣을 자막 상한
MAX_SEGMENTS_FOR_PROMPT=1200

# Whisper
WHISPER_MODEL=small
WHISPER_FP16=true

# 공용
TZ=Asia/Seoul
